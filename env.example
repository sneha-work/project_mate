# ResearchMate AI Environment Variables
# Ollama Cloud API Key & Host
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_HOST=https://api.ollama.com
OLLAMA_MODEL=llama3.3:70b

# Google OAuth Credentials (Optional - Guest login works out of the box)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server settings
PORT=8000
HOST=0.0.0.0
SECRET_KEY=researchmate-super-secret-key-academic-ai-2026
